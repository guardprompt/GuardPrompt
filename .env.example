##############################################
# 🌐 GLOBAL ENVIRONMENT CONFIGURATION
# Applies to: OpenWebUI, Anonymizer, NGINX Proxy
#
# This template is filled in by the install wizard (install.sh / install.ps1).
# Empty passwords/secrets are generated automatically.
##############################################

# ====== 🔐 Licensing & Auth ======
# GuardPrompt licence server. The anonymizer, kb-admin AND gp-transcribe call it
# periodically to validate this installation's machine key (anonymizer/machine_key.txt)
# and to fetch the allowed user count. Without a valid licence the anonymizer refuses
# to process text (returns "[PROCESSING DISABLED: LICENSE IS NOT VALID]") and
# gp-transcribe refuses to transcribe (503), so the system blocks rather than
# leaking. Vendor-provided URL — do not change.
LICENSING_URL_ENV=https://www.dkprojektai.lt

# ====== 🧠 OpenWebUI / LLM ======
# Secret used by OpenWebUI to sign session cookies / JWTs. Auto-generated by the
# install wizard. Changing it logs every user out. Keep it out of version control.
WEBUI_SECRET_KEY=
# On-prem: True = no version-check call to the internet
OFFLINE_MODE=True
# UI language/locale (e.g. lt-LT, en-US)
WEBUI_DEFAULT_LOCALE=lt-LT

# ====== 🤖 docling LLM (LM Studio / vLLM / Ollama / OpenRouter) ======
# LM Studio is Windows-only. On Ubuntu the 'ollama' service (compose profile
# below) serves the vision model in-stack; install.sh sets these automatically.
LM_STUDIO_ENABLED=true
LM_STUDIO_URL=http://ollama:11434/v1/chat/completions
LM_MODEL=gemma3:4b

# Compose profiles to enable. 'ollama' -> starts the in-stack vision LLM so
# `docker compose up -d` includes it without needing --profile on the CLI.
COMPOSE_PROFILES=ollama

# ====== 📚 oikb Knowledge Base Sync ======
# OpenWebUI API key (Settings -> Account -> API Keys; API keys must be ENABLED)
OPEN_WEBUI_API_KEY=
# kb-admin self-healing auth: if the API key is missing/rotated, kb-admin signs in with these
# ADMIN credentials to get a fresh token automatically (set ONCE, survives key rotation / OWUI
# reinstall). Must be an OpenWebUI ADMIN account (users/groups endpoints require admin).
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=
# --- Confluence (Atlassian API token) ---
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
# --- Jira ---
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
# --- SharePoint (Azure app registration) ---
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ====== 🎨 Brand-kit sync (presentation assets, NOT a Knowledge Base) ======
# Mirrors a SharePoint document library (logos, brand PPT templates, photos) into
# the sandbox brand volume for gpdeck. Uses the SHAREPOINT_* app above — it MUST
# be registered in the SAME tenant as the site below. Run: docker compose run --rm
# brand-kit-sync. Leave empty to disable.
BRAND_KIT_SITE_HOST=          # e.g. contoso.sharepoint.com
BRAND_KIT_SITE_PATH=          # e.g. /sites/intranet
BRAND_KIT_LIBRARY=            # document library name; empty = first library
BRAND_KIT_FOLDER=             # optional sub-folder inside the library
BRAND_KIT_EXTENSIONS=         # empty = png,jpg,jpeg,gif,svg,webp,pptx,potx,pdf
BRAND_KIT_INTERVAL=0          # seconds; >0 = loop as a scheduled service
BRAND_KIT_MAX_MB=50

# ====== 🛠️ KB Admin App ======
# Auth mode: openwebui (admin role) | dev (allowlist)
KBADMIN_AUTH_MODE=openwebui
# Session cookie signing secret (auto-generated by install wizard)
KBADMIN_SESSION_SECRET=
# dev mode only: comma-separated admin emails
KBADMIN_ADMIN_EMAILS=

# ====== 🧩 DB ======
# PostgreSQL credentials, shared by OpenWebUI, kb-admin (schema "kbadmin"),
# uploads-cleaner and db-trigger-init. The password is auto-generated on install;
# changing it later requires updating the existing database too.
POSTGRES_USER_ENV=guardprompt
POSTGRES_PASSWORD_ENV=
POSTGRES_DB_ENV=guardprompt

# ====== 🧩 Grafana ======
# Admin login for Grafana, if you enable that (optional monitoring service).
GF_ADMIN_USER_ENV=admin
GF_ADMIN_PASSWORD_ENV=

# ====== 🧩 N8N ======
# Admin password for n8n, if you enable that service (commented out by default).
N8N_ADMIN_PASSWORD=


##############################################
# 🕵️ ANONYMIZATION
# Every category can be turned off separately. The anonymizer runs both on KB
# ingestion and on every chat message before it reaches the LLM. Principle: a
# leak is worse than over-masking — if something gets masked that should not be,
# do not switch the category off, add the term to the ALLOW list at the bottom.
##############################################

# Basic identifiers (deterministic regex).
ANON_PHONE=true           # phone numbers
ANON_IBAN=true            # bank account numbers (IBAN)
ANON_EMAIL=true           # email addresses
ANON_ID=true              # Lithuanian personal code (11 digits)
ANON_CREDIT_CARD=true     # payment card numbers
ANON_CRYPTO=true          # crypto wallet addresses (BTC/ETH/LTC/XRP...)
ANON_ADDRESS=true         # street addresses
ANON_DATE=false           # any date — off: dates are usually needed for context
ANON_COMPANY_NAME=true    # company names in quotes (UAB "Name")
ANON_COMPANY_ID=true      # company registration codes
ANON_VAT=true             # VAT payer codes
ANON_DOCUMENT_NUMBER=false # generic document numbers — off: too broad, catches ordinary references
ANON_MONEY=true           # amounts of money
ANON_IPV4=true            # IPv4 addresses
ANON_IPV6=true            # IPv6 addresses
ANON_LICENSE_PLATE=true   # vehicle plates (LT format + "valst. nr." anchor)
ANON_PERSON=true          # names/surnames (LT dictionary; works together with gliner)
ANON_TIME=false           # time of day — off: rarely identifying

# Mask whole links ([URL]). OFF by default: most links are public references
# (legal acts, institution pages) and masking them all guts the document. With
# ANON_URL=false the other rules still work INSIDE a link (email/token/password
# in a URL is still masked). Turn it on if links themselves are sensitive —
# then ANON_ALLOW_DOMAINS below becomes a real whitelist of visible links.
ANON_URL=false

# GDPR Art. 9/10 special categories (via gliner NER service).
# Runs on raw text before the regex pipeline. Leak is worse than over-mask —
# fix any over-redaction by adding the term to ANON_ALLOW_WORDS below.
#
# NOTE for a TRUSTED internal KB of procedural docs (e.g. Regitra rules): the Art.9/10
# special-category gliner detectors below have a HIGH false-positive rate on legal /
# institutional text ("policijoje"->[POLITICAL], legal refs->[CRIMINAL]) and a low real
# hit rate — they were built for user-generated chat, not curated procedures. If the KB
# content comes out shredded, set the noisy ones to false (POLITICAL/CRIMINAL/RELIGION/
# UNION/ETHNICITY/SEX_LIFE/BELIEF/BIOMETRIC) and keep only hard PII (PERSON/ID/EMAIL/
# PHONE/ADDRESS/IBAN/LICENSE_PLATE). Also add institution/product names to ANON_ALLOW_WORDS
# (e.g. Regitra,policija) and prefer keyword-based ANON_LICENSE_PLATE over ANON_PLATE_NER
# (the no-keyword NER flags "Regitroje" as a plate). Changing these affects only NEW
# extractions — re-sync the KB to fix already-stored content.
#
# Hidden-text (anti prompt-injection) redaction — set false for LOG-ONLY on a trusted KB
# (it false-positives on slide-deck / PPT accessibility text at contrast 0.00 and shreds
# real content into [PROTECTION]; the anonymizer + semantic-injection layer still run).
DOCLING_HIDDEN_REDACT=true
# When redacting, gate it on a local-LLM harm-check: redact hidden text ONLY if it is an
# actual prompt-injection; keep benign invisible content (headings, accessibility text).
# Needs LM_STUDIO_URL/LM_MODEL; fails CLOSED (redacts) if the LLM is unreachable.
DOCLING_HIDDEN_HARM_CHECK=true
ANON_HEALTH=true          # illnesses, diagnoses, mental health (GDPR Art.9)
ANON_CRIMINAL=true        # offences, convictions (GDPR Art.10)
ANON_POLITICAL=true       # political opinions, party membership
ANON_RELIGION=true        # religious belief (gliner + narrow dict: katalikas, musulmonas...)
ANON_UNION=true           # trade-union membership
ANON_BIOMETRIC=true       # fingerprints, face, DNA
ANON_WHISTLEBLOWER=true   # whistleblower reports (gliner + dict: "pranešėja", "informatorius")
ANON_ETHNICITY=true       # racial/ethnic origin (gliner; EU AI Act Art.5(1)(g) + GDPR Art.9)
ANON_SEX_LIFE=true        # sexual orientation / sex life (gliner + narrow dict)
ANON_BELIEF=true          # philosophical/worldview beliefs (gliner + narrow dict)
ANON_PERSON_NER=true      # gliner name supplement (foreign names / inflected forms)
ANON_NAME_COREF=true      # mask inflected repeats of a detected name (Mindaugas->Mindaugo)
ANON_PLATE_NER=true       # gliner plate detection (foreign/vanity plates without keyword)

# Vehicle & IT structured identifiers (anchor + LT-format regex).
# Run before the generic DOCUMENT_NUMBER so precise matches win the collision.
# Plate uses the existing ANON_LICENSE_PLATE flag above.
ANON_DRIVER_LICENSE=true  # driver's licence / DQC no. (anchored on "vairuotojo pažymėjimo Nr.")
ANON_VEHICLE_DOC=true     # vehicle registration certificate (anchored on "registracijos liudijimas")
ANON_MAC=true             # MAC addresses
ANON_VIN=true             # vehicle VIN (17 chars)
ANON_IMEI=true            # IMEI (anchored — bare 15-digit is ambiguous)
ANON_GEO=true             # GPS coordinates (decimal / DMS) — precise geolocation

# ---------------------------------------------------------------------------
# API authentication for the anonymizer service (port 8005).
#
# Comma-separated list of accepted keys. Callers must send
#   Authorization: Bearer <key>        (or  X-API-Key: <key>)
# Empty = NO authentication: anyone who can reach port 8005 may call the API.
# Protects /api/anonimize, /process and /api/webcrawle; the health check "/"
# and /api/reginfo stay open so a new host can still be registered.
#
# When you set this, the same key must also be entered in OpenWebUI:
#   Admin Panel -> Settings -> Documents -> External Document Loader API Key
# (OpenWebUI already sends that key as a Bearer token on every upload.)
ANON_API_KEYS=

# The key the GuardPrompt chat filter (gp-pipeline) presents to the anonymizer.
# Singular on purpose: ANON_API_KEYS above is the server's list of ACCEPTED keys,
# this is the ONE key this client sends. It must be one of them.
# Leave both empty to keep the API open.
ANON_API_KEY=

# Secret that makes the "already anonymized" skip-mark UNFORGEABLE. The pipeline
# tags text it has masked with an invisible marker so it is not re-masked on later
# turns. With a fixed/empty marker an attacker could embed that marker in an
# uploaded document, a fetched web page or tool output and skip masking the WHOLE
# message (raw PII -> external LLM). Set a strong random value shared by all
# components, e.g. `openssl rand -hex 32`. Empty = falls back to a forgeable marker
# (still safe: inbound marks are stripped and text re-anonymized, just slower).
GP_ANON_MARK_SECRET=
# ---------------------------------------------------------------------------

# Models for which the OWUI filter pipeline SKIPS its one-way masking, because they
# route through the REVERSIBLE gp-openai-proxy (which masks outbound AND restores the
# real values in the response — needed for in-place text editing, e.g. the browser
# extension rewriting an email that contains names). Comma-separated model ids or
# id-prefixes as they appear in OWUI. EMPTY (default) = every model is masked exactly
# as before (no behaviour change). Only set this once such a model/connection exists.
GP_PIPELINE_SKIP_MODELS=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GuardPrompt Claude proxy (port 8006) — the LLM gateway for Claude Code, the
# VS Code extension and the Claude desktop app. Pseudonymizes outgoing content
# and restores it on the way back; the mapping stays on this machine.
#
# TWO CREDENTIAL MODES — chosen by whether GP_UPSTREAM_API_KEY below is set.
# This is a SINGLE GLOBAL switch for the whole proxy, NOT per-user. You cannot
# mix subscription users and API-key users in one proxy instance (run two
# instances on two ports if you need both).
#
#   MODE A — SUBSCRIPTION PASS-THROUGH   (GP_UPSTREAM_API_KEY empty — the default)
#     Every developer stays logged in with THEIR OWN claude.ai subscription
#     (Pro / Max / Team). The proxy relays their login untouched. Nobody without
#     a subscription can use it. No key to manage here. GP_PROXY_KEYS is IGNORED
#     in this mode — protect the port at the network layer (loopback + VPN /
#     reverse proxy) instead. Use this when your people have their own Pro/Team.
#
#   MODE B — SHARED API KEY              (GP_UPSTREAM_API_KEY set)
#     The proxy holds ONE Anthropic API key and uses it for everyone; developers
#     need NO claude.ai account. Access is controlled by GP_PROXY_KEYS instead
#     (one gate token per person). Use this to let license-less people work, or
#     to centralize billing. NOTE: the Anthropic API key is a per-token-billed
#     product from console.anthropic.com — a DIFFERENT thing from a Pro/Team
#     chat subscription. Billed by usage, not a flat monthly fee.
#
# Where to send requests. Keep the default unless routing through a cloud
# provider's Claude endpoint.
GP_UPSTREAM_BASE_URL=https://api.anthropic.com
# Force IPv4 to the upstream. On IPv4-only egress networks DNS still returns an
# IPv6 (AAAA) record for api.anthropic.com and httpx (no happy-eyeballs) tries it
# first, failing with "Network is unreachable" / "No route to host" though IPv4
# works. Default true pins IPv4. Set false only with working IPv6 egress.
GP_FORCE_IPV4=true
# MODE SELECTOR. Empty -> Mode A (pass-through). A real "sk-ant-..." key from
# console.anthropic.com -> Mode B. Lives only here; developers never hold it.
GP_UPSTREAM_API_KEY=
# Gate tokens developers present to the proxy (Bearer <key> or x-api-key).
# USED ONLY IN MODE B. One per developer so offboarding revokes a single key;
# it also identifies who sent what (vault scope + audit). Generate strong random
# values, e.g. "gpk_$(openssl rand -hex 20)". Empty in Mode B = requests refused
# unless GP_ALLOW_NO_AUTH=true (below). Ignored entirely in Mode A.
GP_PROXY_KEYS=

# Both LLM proxies bind to 0.0.0.0 and relay on the operator's upstream key, so an
# unauthenticated caller is an open, billable relay reaching the vault. DEFAULT
# (this false): when NO proxy keys are configured, requests are REFUSED
# (fail-closed). Set true ONLY for a deployment firewalled at the network layer
# that you intend to run without per-caller keys. Applies to GP_PROXY_KEYS (Mode B)
# and GP_OAI_PROXY_KEYS. (Mode A subscription pass-through authenticates upstream,
# so this does not apply there.)
GP_ALLOW_NO_AUTH=false
# ---------------------------------------------------------------------------

# Developer / IT secrets (regex; prefixes from gitleaks rule sets).
ANON_TOKEN=true           # cloud/SaaS tokens: AWS/GitHub/OpenAI/Slack/Google/Stripe/JWT
ANON_CERT_KEY=true        # PEM private keys, certificates, SSH keys (multiline)
ANON_CONN_STRING=true     # scheme://user:pass@host, Bearer/Authorization
ANON_SECRET_KV=true       # config key=value: password=/secret=/api_key=/token:

# Personal / financial / case document numbers (regex; anchored + some standalone).
ANON_PASSPORT=true        # passport no. (LT 2 letters+6 digits, or anchored)
ANON_ID_CARD=true         # ID card no. (anchored — bare 8-digit is ambiguous)
ANON_SODRA=true           # SODRA / social insurance no. (anchored)
ANON_SWIFT=true           # SWIFT/BIC bank codes
ANON_CASE_NO=true         # court case / contract no. (anchored on "Bylos Nr." / "Sutarties Nr.")
ANON_MEDICAL_NO=true      # patient / medical record no. (anchored)
ANON_LICENSE_KEY=true     # product / license keys (XXXXX-XXXXX-...)

# gliner unreachable -> BLOCK the request ("[PROCESSING DISABLED: ANONYMIZATION
# SERVICE UNAVAILABLE]") instead of silently returning text without Art. 9/10
# coverage. Set false only if availability matters more than completeness.
ANON_REQUIRE_GLINER=true

# gliner service tuning (defaults are sane; override only if needed)
# GLINER_URL=http://gliner:8000
# GLINER_THRESHOLD=0.40           # Art. 9/10 min score
# GLINER_PERSON_MIN_SCORE=0.5     # person supplement min score
# GLINER_CONTAINER_THRESHOLD=0.3  # container-side prefilter (keep low)
# GLINER_MODEL_ID=urchade/gliner_multi_pii-v1

# Custom anonymization (comma separated) - this rule comes first
ANON_CUSTOM_WORDS=www.guardprompt.lt,guardprompt

# Mask patterns using character placeholders - this rule comes second
# # or 9 - random digit (0-9)
# A - random uppercase letter
# a - random lowercase letter
# X - random uppercase alphanumeric
# x - random lowercase alphanumeric
# * - random any language character (letter or digit)
ANON_MATCH_MASKS="
AAAA-***#-**xX
*vaigždė
LT##################
"

##############################################
# 🟢 ALLOW / WHITELIST (highest priority)
##############################################

# Exact words or phrases (case-insensitive). Example: your own contact address,
# which must stay readable instead of turning into [EMAIL].
ANON_ALLOW_WORDS=info@pavyzdys.lt

# Domains and URLs that must stay visible. The WHOLE url containing the domain is
# protected (not just the domain text), so trusted references survive intact.
# Two roles: (1) with ANON_URL=false — shields these links from other rules that
# might hit their path/ID; (2) with ANON_URL=true — this is the whitelist of the
# only links that stay visible.
ANON_ALLOW_DOMAINS=lrv.lt,vmi.lt,sodra.lt,e-tar.lt,e-seimas.lrs.lt,pavyzdys.lt

# Regex patterns that must never be anonymized. Example: your own company name,
# so it is not masked as [COMPANY_NAME] in every document.
ANON_ALLOW_REGEX=AB\s+["“”„']?Pavyzdys["“”„']?

##############################################
# 🌐 Extracting and serving images from PDFs (see DOCLING_PUBLIC_* at the end)

# ====== 🗑️ Uploads Cleaner ======
# Data-retention safeguard: the uploads-cleaner container deletes uploaded files
# (DB rows + files on disk + their vectors) older than X days, once a day at the
# given hour (0-23). Files that belong to a knowledge base are NOT deleted.
CLEANER_DELETE_AFTER_DAYS=30
CLEANER_RUN_HOUR=2

# ====== 🎙️ STT (speech → text) — LOCAL gp-transcribe ======
# Voice input is transcribed by the LOCAL gp-transcribe engine (Lithuanian svogunas
# model, auto-detects EN too, no egress — audio never leaves the machine).
# install.sh / install.ps1 point OpenWebUI at it automatically
# (audio.stt.openai.api_base_url = http://gp-transcribe:8000/v1,
# audio.stt.openai.api_key = GP_STT_API_KEYS below).
# Bearer key(s) for gp-transcribe's OpenAI-compatible /v1/audio/transcriptions
# endpoint (comma-separated). Empty = open (internal network + license gate only).
# If set, it MUST equal OpenWebUI's audio.stt.openai.api_key. Generate e.g.
# `openssl rand -hex 24`.
GP_STT_API_KEYS=

# ====== 🔐 LDAP / Active Directory (OpenWebUI login) ======
# ENABLE_LDAP=true turns on LDAP login in OpenWebUI. Leave it false until host /
# DN / credentials below are configured — otherwise login breaks.
ENABLE_LDAP=false
LDAP_SERVER_LABEL=Active Directory   # name shown on the login button
LDAP_SERVER_HOST=ad.example.lt       # your domain controller
LDAP_SERVER_PORT=636                 # 636 = LDAPS (encrypted, default); 389 = plaintext (avoid)
# TLS (LDAPS) ON by default so the AD bind account and each user's credentials are
# never sent in the clear over the LAN. Only drop to 389 / disable TLS on an
# isolated test network.
LDAP_USE_TLS=true
LDAP_VALIDATE_CERT=true
# Point this at your AD CA so the certificate is actually verified (needed with
# LDAP_VALIDATE_CERT=true unless the CA is already in the system trust store):
# LDAP_CA_CERT_FILE=/app/backend/data/certs/ad-ca.crt

# Service account used for the search (bind DN + password)
LDAP_APP_DN=CN=LDAP AI,OU=SisteminiaiVartotojai,DC=example,DC=lt
LDAP_APP_PASSWORD=

# Where to search for users, and which attributes map to username / email
LDAP_SEARCH_BASE=DC=example,DC=lt
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail

# Public address of THIS deployment (install.sh/.ps1 asks for it). Used to build
# docling image links — and auto-allowlisted by the anonymizer, so links to your
# own instance are never masked. Set it to your real domain.
DOCLING_PUBLIC_SCHEME=https
DOCLING_PUBLIC_HOST=chat.example.com
DOCLING_PUBLIC_PORT=

# Per-process GPU VRAM cap for docling in GB (default 6). Raise on a roomy GPU
# (e.g. 16 on a 24GB card); it shares the GPU with gliner + embeddings/reranker.
DOCLING_CUDA_MEM_GB=6

# --- Zabbix monitoring stack DB (ZABBIX_DB_PASSWORD generated by install) ---
ZABBIX_DB_USER=zabbix
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_PASSWORD=
# Bundled Zabbix server/web image tag. 7.0 LTS (matches the corporate server).
# Bumping a tag with an existing DB volume triggers an in-place schema upgrade.
ZBX_VERSION=7.0-latest

# --- Qdrant REST API key (internal-net hardening; generated by install) ---
# All qdrant clients (OpenWebUI native, kb-admin, uploads-cleaner) send it.
# /metrics + health endpoints stay exempt, so monitoring is unaffected.
# Empty = qdrant runs with no auth (any container on the net can read/write).
QDRANT_API_KEY=

# --- Open Terminal (sandboxed command execution inside OpenWebUI) -------------
# Auth token OpenWebUI sends to reach the terminal sandbox. Register the sandbox
# in Admin -> Integrations -> Open Terminal (URL http://open-terminal:8000).
# Terminal output is anonymized before the LLM sees it (gp-pipeline tool-role
# masking). Generated by install.sh/.ps1. Runs MULTI_USER (per-user home
# isolation, no sudo) with a default block-ALL egress firewall.
OPEN_TERMINAL_API_KEY=
# Egress: unset = block ALL outbound (no exfil). Comma list to whitelist:
# OPEN_TERMINAL_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,github.com
# Dev tools pre-installed before the firewall locks down:
# OPEN_TERMINAL_PIP_PACKAGES=pandas numpy requests
# OPEN_TERMINAL_NPM_PACKAGES=
# OPEN_TERMINAL_PACKAGES=

# --- Corporate Zabbix integration (OPT-IN, profile "external-zabbix") ---------
# Only needed to forward metrics to an EXISTING company Zabbix via a local
# Zabbix proxy. Leave empty for the bundled standalone Zabbix. See
# ZABBIX-INTEGRATION.md. Start: docker compose --profile external-zabbix up -d zabbix-proxy
CORP_ZABBIX_SERVER=        # company Zabbix server (or its proxy) hostname/IP
CORP_ZABBIX_PORT=10051
ZBX_PROXY_NAME=GuardPrompt-proxy    # must match the Proxy name created in corporate Zabbix
ZBX_PROXY_PSK_ID=GuardPrompt-proxy  # PSK identity (non-secret); the key lives in monitoring/zabbix_proxy.psk
# Proxy image tag — MUST match your corporate Zabbix SERVER major (a 6.0 proxy
# cannot talk to a 7.0 server). Our corporate server is 7.0 -> keep 7.0-latest.
ZBX_PROXY_VERSION=7.0-latest

# ====== 🛡️ Security hardening knobs (optional; safe defaults) ======
# All default to the SECURE choice — set these only to deliberately relax/tighten.
#
# gp-claude-proxy: trust inbound X-GP-User / X-Forwarded-For for the audit log ONLY
# when a trusted reverse proxy injects them (it must strip any client-sent value).
# Default false = ignore client-claimed identity (the tamper-proof `owner` hash is
# always logged regardless). Set true only behind such a trusted hop.
GP_TRUST_CLIENT_IDENTITY=false
#
# gp-transcribe / gp-claude-proxy license: fail-open (grace) on an unreachable
# license server so infra hiccups don't take prod down. Set false to fail CLOSED.
# GP_LICENSE_GRACE=true
#
# anonymizer: require the semantic prompt-injection scan (fail CLOSED when gliner's
# /injection is down) instead of passing text through. Default false (regex layer +
# capability limits still apply on a detector outage).
ANON_INJECTION_REQUIRE=false
#
# kb-admin: mark the session cookie Secure (HTTPS-only). Default true; modern
# browsers still send Secure cookies to http://localhost, so set false only for a
# non-localhost plain-HTTP deployment.
KBADMIN_COOKIE_SECURE=true
#
# uploads-cleaner: refuse to delete when the KB/note protect-set is empty but there
# are more than N deletion candidates (guards against an OpenWebUI schema drift
# silently wiping attached files). Set CLEANER_ALLOW_EMPTY_PROTECT=1 for a genuinely
# empty deployment.
CLEANER_EMPTY_PROTECT_FLOOR=5
CLEANER_ALLOW_EMPTY_PROTECT=false
#
# gp-transcribe: per-request memory caps (DoS guard for direct internal-net calls;
# nginx already limits the public path). Audio read ceiling and text-field ceiling.
GP_MAX_AUDIO_MB=400
GP_MAX_TEXT_MB=12

# ====== 🧠 OpenAI proxy → OpenRouter (gp-openai-proxy) ======
# OpenAI-compatible gateway with REVERSIBLE anonymization, for OpenAI-protocol
# tools (SQL Developer / SQLcl / Continue). Endpoint: 127.0.0.1:8013/v1/chat/completions.
# The upstream model is PINNED here — clients cannot pick another. Required.
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
# OpenRouter base (OpenAI-compatible). Default is fine.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# --- Second reversible proxy for the GuardPrompt browser extension (gp-openai-proxy-
# browser). Same code, GENERAL model (Gemini) for email/page answers. Internal only,
# no published port. GP_BROWSER_MODEL_ID = the DISTINCT id OWUI shows (so it doesn't
# collide with the direct OpenRouter Gemini); the extension locks to it. Change per
# deployment if you want a client-specific id.
GP_BROWSER_OPENROUTER_MODEL=google/gemini-2.5-flash
GP_BROWSER_MODEL_ID=gp-browser
# Leave EMPTY to reuse the OpenRouter key already stored in OpenWebUI. Set only to
# override with a dedicated key.
OPENROUTER_API_KEY=
# Bearer key(s) the client tools present to gp-openai-proxy (comma-separated).
# Empty = requests REFUSED unless GP_ALLOW_NO_AUTH=true (see above).
# Generate e.g. `openssl rand -hex 24`.
GP_OAI_PROXY_KEYS=

# ====== 🔎 gp-websearch (OpenWebUI "External" web search via OpenRouter) ======
# Adapter so any model can use the on-demand web-search toggle, backed by OpenRouter's
# built-in web search (Exa) — no searxng, no separate search-API key, no online model.
# OWUI: Admin -> Settings -> Web Search -> Engine=External, URL=http://gp-websearch:8000/search,
# key=GP_WEBSEARCH_AUTH_KEY.
# Real OpenRouter key (same one used in the OWUI OpenRouter connection). REQUIRED.
GP_WEBSEARCH_OPENROUTER_KEY=
# Bearer secret OWUI presents to the adapter (generate `openssl rand -hex 24`).
GP_WEBSEARCH_AUTH_KEY=
# Cheap model that just carries the web plugin (its text answer is ignored).
GP_WEBSEARCH_MODEL=google/gemini-3.5-flash-lite
# Search engine OpenRouter uses: exa | parallel | auto ($0.005/search on exa/parallel).
GP_WEBSEARCH_ENGINE=exa
