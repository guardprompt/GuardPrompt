# Force LF on files that run inside Linux containers / shells.
# Prevents Windows CRLF from breaking entrypoint scripts (e.g. "sh: bad interpreter").
*.sh   text eol=lf
*.py   text eol=lf
*.conf text eol=lf
install.sh text eol=lf
.env.example text eol=lf

# Treat as binary (no EOL conversion)
*.png  binary
*.svg  text
